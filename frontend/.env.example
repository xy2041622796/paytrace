# ============================================================
# 前端环境变量（复制为 .env 并填入你的 Supabase 项目值）
# 注意：VITE_ 前缀的变量会暴露到浏览器，仅放 anon key（公开安全）
# Service Role Key / agnes Key 等敏感凭证只放 Supabase 后台 Secrets，绝不在前端出现
# ============================================================

# Supabase 项目 URL（Dashboard → Project Settings → API）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key（公开，受 RLS 保护）
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 说明：agnes-3.0-flash 的 API Key 不在此处，部署 Edge Function agnes-proxy 时
# 通过 Supabase CLI `supabase secrets set AGNES_API_KEY=xxx` 写入服务端 Secrets。
